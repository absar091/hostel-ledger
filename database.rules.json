{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "userGroups": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "groups": {
      "$groupId": {
        ".read": "auth != null && (root.child('userGroups').child(auth.uid).child($groupId).exists() || data.child('createdBy').val() === auth.uid)",
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)",
        "members": {
          ".write": "auth != null && root.child('userGroups').child(auth.uid).child($groupId).exists()"
        }
      }
    },
    "transactions": {
      "$txnId": {
        ".read": "auth != null && root.child('userTransactions').child(auth.uid).child($txnId).exists()",
        ".write": false
      }
    },
    "userTransactions": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
      }
    },
    "emailVerification": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "invitations": {
      ".read": false,
      ".write": false
    },
    "userInvitations": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "p2p_transactions": {
      "$txnId": {
        ".read": "auth != null && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)",
        ".write": false
      }
    },
    "user_p2p_transactions": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "fcm_tokens": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "pushSubscriptions": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "oneSignalPlayers": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    }
  }
}
