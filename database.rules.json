{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid && auth != null",
        "walletBalance": {
          ".validate": "!newData.exists() || (data.exists() && newData.val() === data.val())"
        },
        "settlements": {
          ".validate": "!newData.exists() || (data.exists() && newData.val() === data.val())"
        },
        ".validate": "newData.hasChildren(['uid', 'email', 'name', 'createdAt']) && newData.child('uid').val() === $uid",
        "role": {
          ".validate": "(!data.exists() && newData.val() === 'user') || (data.exists() && newData.val() === data.val())"
        }
      }
    },
    "groups": {
      "$groupId": {
        ".read": "auth != null && (root.child('userGroups').child(auth.uid).child($groupId).exists() || data.child('createdBy').val() === auth.uid)",
        ".write": "auth != null && (root.child('userGroups').child(auth.uid).child($groupId).exists() || data.child('createdBy').val() === auth.uid || !data.exists())",
        ".validate": "newData.hasChildren(['name', 'emoji', 'members', 'createdBy', 'createdAt'])"
      }
    },
    "userGroups": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid && auth != null"
      }
    },
    "budgets": {
      "$groupId": {
        ".read": "auth != null && root.child('userGroups').child(auth.uid).child($groupId).exists()",
        ".write": "auth != null && root.child('userGroups').child(auth.uid).child($groupId).exists()",
        ".validate": "newData.hasChildren(['limit', 'spent', 'policy'])"
      }
    },
    "personalBudgets": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        ".validate": "newData.hasChildren(['limit', 'spent', 'resetPeriod', 'lastReset'])"
      }
    },
    "transactions": {
      ".indexOn": [
        "timestamp",
        "groupId"
      ],
      "$transactionId": {
        ".read": "auth != null && root.child('userTransactions').child(auth.uid).child($transactionId).exists()",
        ".write": false,
        ".validate": "newData.hasChildren(['groupId', 'type', 'amount', 'createdAt']) && newData.child('amount').isNumber() && newData.child('amount').val() > 0"
      }
    },
    "userTransactions": {
      "$uid": {
        ".indexOn": [
          "groupId"
        ],
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid && auth != null"
      }
    },
    "verificationCodes": {
      ".read": false,
      ".write": false
    },
    "userSecrets": {
      ".read": false,
      ".write": false
    },
    "emailVerification": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        ".validate": "newData.hasChildren(['email', 'emailVerified'])"
      }
    },
    "pushSubscriptions": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid && auth != null",
        ".validate": "newData.hasChildren(['subscription', 'updatedAt']) || newData.hasChildren(['fcmToken', 'updatedAt'])"
      }
    },
    "oneSignalPlayers": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid && auth != null",
        ".validate": "newData.hasChildren(['playerId', 'updatedAt']) && newData.child('playerId').isString()"
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'createdAt']) && newData.child('uid').isString()"
      }
    },
    "invitations": {
      "$invitationId": {
        ".read": "auth != null && (data.child('senderId').val() === auth.uid || data.child('receiverId').val() === auth.uid)",
        ".write": false,
        ".validate": "newData.hasChildren(['groupId', 'senderId', 'receiverId', 'status', 'createdAt'])"
      }
    },
    "userInvitations": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid && auth != null"
      }
    },
    "groupMessages": {
      "$groupId": {
        ".read": "auth != null && root.child('userGroups').child(auth.uid).child($groupId).exists()",
        ".write": "false",
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "expenseMessages": {
      "$groupId": {
        "$expenseId": {
          ".read": "auth != null && root.child('userGroups').child(auth.uid).child($groupId).exists()",
          ".write": "false",
          ".indexOn": [
            "timestamp"
          ]
        }
      }
    },
    "expenseChatMeta": {
      "$groupId": {
        "$expenseId": {
          ".read": "auth != null && root.child('userGroups').child(auth.uid).child($groupId).exists()",
          ".write": "false"
        }
      }
    },
    "supportTickets": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "adminNotifications": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      ".write": "auth != null",
      "$notifId": {
        ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')"
      }
    },
    "settings": {
      "system": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')"
      },
      "broadcast": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || $uid === auth.uid)"
      }
    }
  }
}